<Window x:Class="CarsharingApp.AddCarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarsharingApp"
        mc:Ignorable="d"
        Title="Добавление машины" Height="420" Width="380">

    <Window.Background>
        <SolidColorBrush Color="LightGray"/>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Добавить машину"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10" 
                   FontFamily="Arial"
                   Foreground="DarkBlue"/>

        <Label Content="Модель:" Grid.Row="1" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="Model" 
                 Grid.Row="1"
                 Margin="130,0,0,5"
                 Height="30"
                 Background="White"/>

        <Label Content="Цена за час:" Grid.Row="2" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="PricePerHour" 
                 Grid.Row="2" 
                 Margin="130,0,0,5"
                 Height="30"
                 Background="White"/>

        <Label Content="Номер:" Grid.Row="3" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="Number" 
                 Grid.Row="3" 
                 Margin="130,0,0,5"
                 Height="30"
                 Background="White"/>

        <Label Content="Цвет:" Grid.Row="4" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="Color" 
                 Grid.Row="4" 
                 Margin="130,0,0,5"
                 Height="30"
                 Background="White"/>

        <Label Content="Расход топлива:" Grid.Row="5" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="FuelConsumption"
                 Grid.Row="5" 
                 Margin="130,0,0,5"
                 Height="30"
                 Background="White"/>

        <Label Content="Число мест:" Grid.Row="6" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="NumberOfSeats" 
                 Grid.Row="6" 
                 Margin="130,0,0,5"
                 Height="30"
                 Background="White"/>

        <Label Content="Класс автомобиля:" Grid.Row="7" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="CarClass" 
                 Grid.Row="7" 
                 Margin="130,0,0,5"
                 Height="30"
                 Background="White"/>

        <Button Content="Добавить"
                Width="120" 
                Height="30"     
                Background="SteelBlue"    
                Foreground="White"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Cursor="Hand"   
                Grid.Row="8" 
                Margin="0,10,0,0" 
                BorderThickness="0"/>
    </Grid>
</Window>