<Page x:Class="CarsharingApp.CarsharingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CarsharingApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CarsharingPage">

    <Page.Background>
        <SolidColorBrush Color="LightGray"/>
    </Page.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Каршеринг"
               FontSize="24"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,10" 
               FontFamily="Arial"
               Foreground="DarkBlue"/>

        <Grid Grid.Row="1" VerticalAlignment="Top" Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Name="GuestsDataGrid" 
                  Grid.Row="2" 
                  AutoGenerateColumns="False" 
                  Height="250"
                  Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Модель" Binding="{Binding Cars_id}" Width="Auto"/>
                    <DataGridTextColumn Header="Клиенты" Binding="{Binding Customers_id}" Width="Auto"/>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding Price_id}" Width="Auto"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Product}" Width="Auto"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding BookingDate}" Width="Auto"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Sum}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left">

                <Button Content="Забронировать"
                    Width="120" 
                    Height="30"     
                    Background="SteelBlue"    
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"   
                    BorderThickness="0"
                    Margin="0,0,10,0" 
                    Click="BookingButton_Click"/>

                <Button Content="Удалить бронирование"
                    Width="150" 
                    Height="30"   
                    Background="Gray"
                    Foreground="White"
                    FontWeight="Bold"
                    Cursor="Hand"   
                    BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>