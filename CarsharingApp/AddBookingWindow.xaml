<Window x:Class="CarsharingApp.AddBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarsharingApp"
        mc:Ignorable="d"
        Title="Добавление бронирования" Height="420" Width="420">

    <Window.Background>
        <SolidColorBrush Color="LightGray"/>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Добавить бронирование"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10" 
                   FontFamily="Arial"
                   Foreground="DarkBlue"/>

        <Label Content="Продукция:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="Model" Grid.Row="1" Grid.Column="1" Margin="10,5,0,5" Height="30" Background="White"/>

        <Label Content="Клиент:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="Client" Grid.Row="2" Grid.Column="1" Margin="10,5,0,5" Height="30" Background="White"/>

        <Label Content="Дата начала:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#333333"/>
        <DatePicker x:Name="BookingDate" 
                    Width="140" 
                    Height="30" 
                    Grid.Row="3" 
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Margin="10,5,0,5"
                    Background="White"/>

        <Label Content="Дата окончания:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#333333"/>
        <DatePicker x:Name="BookingDate2" 
                    Width="140" 
                    Height="30" 
                    Grid.Row="4" 
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Margin="10,5,0,5"
                    Background="White"/>

        <Label Content="Кол-во:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="Count" Grid.Row="5" Grid.Column="1" Margin="10,5,0,5" Height="30" Background="White"/>

        <Label Content="Сумма:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#333333"/>
        <TextBox x:Name="Sum" Grid.Row="6" Grid.Column="1" Margin="10,5,0,5" Height="30" Background="White"/>

        <Button Content="Добавить"
                Width="120" 
                Height="30"     
                Background="SteelBlue"    
                Foreground="White"
                FontWeight="Bold"
                HorizontalAlignment="Left"
                Cursor="Hand"   
                Grid.Row="7" 
                Grid.Column="1"
                Margin="10,10,0,5" 
                BorderThickness="0"/>
    </Grid>
</Window>