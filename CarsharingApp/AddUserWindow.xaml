<Window x:Class="CarsharingApp.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarsharingApp"
        mc:Ignorable="d"
        Title="Окно добавления пользователя" Height="380" Width="420">

    <Window.Background>
        <SolidColorBrush Color="LightGray"/>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Имя:" Grid.Row="0" FontWeight="Bold" Foreground="#333333" Margin="-21,0,21,0"/>
        <TextBox x:Name="Fname_user" Grid.Row="0" Margin="100,0,0,5" Height="30" Background="White"/>

        <Label Content="Фамилия:" Grid.Row="1" FontWeight="Bold" Foreground="#333333" Margin="-21,0,21,0"/>
        <TextBox x:Name="LName_user" Grid.Row="1" Margin="100,0,0,5" Height="30" Background="White"/>

        <Label Content="Имя пользователя:" Grid.Row="2" FontWeight="Bold" Foreground="#333333" Margin="-21,0,21,0"/>
        <TextBox x:Name="Username" Grid.Row="2" Margin="100,0,0,5" Height="30" Background="White"/>

        <Label Content="Пароль:" Grid.Row="3" FontWeight="Bold" Foreground="#333333" Margin="-21,0,21,0"/>
        <PasswordBox x:Name="UserPasssword" Grid.Row="3" Margin="100,0,0,5" Height="30" Background="White"/>

        <Label Content="Роль:" Grid.Row="4" FontWeight="Bold" Foreground="#333333" Margin="-21,0,21,0"/>

        <ComboBox x:Name="RoleCombobox" Grid.Row="4" Margin="100,0,0,5" Height="30" Background="White">
            <ComboBoxItem Content="Admin"/>
            <ComboBoxItem Content="Manager"/>
            <ComboBoxItem Content="Client"/>
        </ComboBox>

        <Button Content="Добавить"
            Width="120" 
            Height="30"     
            Background="SteelBlue"    
            Foreground="White"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Cursor="Hand"   
            Grid.Row="5" 
            Margin="0,10,0,0" 
            BorderThickness="0" 
            Click="Button_Click"/>
    </Grid>
</Window>